# LLM provider (any OpenAI-compatible Chat Completions endpoint). Default: OpenRouter free models.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-replace-me
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional OpenRouter model fallbacks (comma-separated, max 3). Leave empty to disable.
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
# Reasoning effort hint (OpenRouter "reasoning" param): none | low | medium | high. Empty = do not send.
# "none" disables thinking on reasoning models (measured: 10 s -> 3.4 s per answer, same correctness).
LLM_REASONING_EFFORT=none
# Equivalent list prices used for cost reporting (US$ per 1M tokens). Free tiers: 0.
LLM_INPUT_PRICE_PER_M=0
LLM_OUTPUT_PRICE_PER_M=0

# Resilience
LLM_TIMEOUT_S=15
LLM_CONNECT_TIMEOUT_S=3
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=2
QUESTION_DEADLINE_S=30
MAX_TOOL_ITERATIONS=4
MAX_TOOL_REPAIRS=2
MAX_COST_USD_PER_QUESTION=0.05
MAX_TOKENS_PER_QUESTION=16000
CB_FAILURE_THRESHOLD=3
CB_OPEN_S=30

LOG_LEVEL=info

# Ports published by docker compose
WEB_PORT=8080
API_PORT=8000
