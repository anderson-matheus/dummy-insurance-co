# Demo configuration: offline stub provider, no key needed.
# Usage: docker compose --env-file .env.demo --profile demo up --build
ENV_FILE=.env.demo
LLM_BASE_URL=http://stub-llm:8010/v1
LLM_API_KEY=demo
LLM_MODEL=stub/model:free
LLM_FALLBACK_MODELS=
LLM_REASONING_EFFORT=
LLM_TIMEOUT_S=15
QUESTION_DEADLINE_S=30
LOG_LEVEL=info

# Ports published on the host for the demo (avoid clashes with other local services)
API_PORT=18000
WEB_PORT=18080
STUB_PORT=18010
